{
    "power_sources": [
        {
            "name": "charger_ip2366",
            "type": "charger",
            "config": {
                "i2c_dev": "/dev/i2c-2",
                "addr": 234,
                "int_gpio_chip": "gpiochip0",
                "int_gpio_line": 39,
                "charge_en_gpio_chip": "gpiochip2",
                "charge_en_gpio_line": 4,
                "int_poll_interval_ms": 100
            },
            "params": {
                "pdo_select": 5,
                "charge_voltage_mv": 4200,
                "charge_current_ma": 3000,
                "trickle_current_ma": 200,
                "stop_current_ma": 100
            }
        },
        {
            "name": "battery_bms",
            "type": "battery",
            "config": {
                "tty_device": "/dev/ttyS2",
                "baud_rate": 115200
            },
            "poll": {
                "core_period_ms": 500,
                "soc_period_ms": 2000,
                "fault_period_ms": 10000,
                "fault_count_period_ms": 60000,
                "enable_voltage": true,
                "enable_current_temp": true,
                "enable_soc_capacity": true,
                "enable_fault": true,
                "enable_fault_count": false,
                "enable_charge_current": false
            }
        }
    ],

    "charge_manager": {
        "adapter_debounce_ms": 200,
        "fault_debounce_ms": 500,
        "recovery_debounce_ms": 2000,
        "full_soc_percent": 100,
        "full_current_ma": 200,
        "recharge_hysteresis_mv": 200,
        "cc_timeout_min": 240,
        "total_timeout_min": 480,
        "pd_timeout_ms": 10000,
        "cross_verify_charge": true,
        "vbus_present_mv": 4000
    },

    "safety": {
        "max_temp_c": 85,
        "resume_temp_c": 75,
        "max_current_ma": 30000,
        "min_voltage_per_cell_mv": 2800,
        "max_cell_voltage_diff_mv": 300,
        "charge_full_timeout_min": 480
    }
}
